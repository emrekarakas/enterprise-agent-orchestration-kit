{
  "Persistence": {
    "Provider": "InMemory"
  },
  "Cache": {
    "Provider": "InMemory"
  },
  "Redis": {
    "ConnectionString": "localhost:6379,abortConnect=false",
    "KeyPrefix": "eaokit"
  },
  "Authentication": {
    "Mode": "DevelopmentTokens",
    "Authority": "",
    "Audience": "enterprise-agent-api",
    "RequireHttpsMetadata": true,
    "DevelopmentTokenLifetimeMinutes": 60
  },
  "ConnectionStrings": {
    "Postgres": ""
  },
  "AI": {
    "Provider": "DeterministicFake"
  },
  "AzureOpenAI": {
    "Endpoint": "",
    "ChatDeployment": "",
    "StructuredOutputDeployment": "",
    "EmbeddingDeployment": "",
    "CredentialMode": "DefaultAzureCredential",
    "ManagedIdentityClientId": "",
    "ApiKey": "",
    "SendMaxOutputTokens": true,
    "SendTemperature": true
  },
  "OpenAiCompatible": {
    "Endpoint": "http://localhost:11434/v1",
    "ChatModel": "",
    "StructuredOutputModel": "",
    "EmbeddingModel": "",
    "ApiKey": "",
    "TimeoutSeconds": 60
  },
  "DocumentWorker": {
    "Enabled": false,
    "BaseUrl": "http://localhost:8090",
    "TimeoutSeconds": 30,
    "MaxUploadBytes": 26214400
  },
  "ConversationMemory": {
    "FetchLimit": 50,
    "MaxMessages": 12,
    "MaxCharacters": 12000
  },
  "Search": {
    "Provider": ""
  },
  "Retrieval": {
    "MinimumGroundingScore": 0.2,
    "RequireLexicalEvidenceOverlap": true
  },
  "AzureAiSearch": {
    "Endpoint": "",
    "IndexName": "idx-eaokit-chunks-v1",
    "ApiVersion": "2026-04-01",
    "SemanticConfiguration": "sem-eaokit-grounding-v1",
    "VectorField": "contentVector",
    "MinimumGroundingScore": 0.5,
    "CredentialMode": "DefaultAzureCredential",
    "ManagedIdentityClientId": "",
    "ApiKey": ""
  },
  "AzureBlobStorage": {
    "Enabled": false,
    "ServiceUri": "",
    "ContainerName": "eaokit-documents-dev",
    "CredentialMode": "DefaultAzureCredential",
    "ManagedIdentityClientId": "",
    "ConnectionString": ""
  },
  "AzureServiceBus": {
    "FullyQualifiedNamespace": "",
    "TopicName": "agent-events",
    "SubscriptionName": "orchestrator",
    "CredentialMode": "DefaultAzureCredential",
    "ManagedIdentityClientId": "",
    "ConnectionString": ""
  },
  "Messaging": {
    "Provider": "InMemory"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
