<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <UserSecretsId>enterprise-agent-orchestration-kit-local</UserSecretsId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Orchestrator.Contracts/Orchestrator.Contracts.csproj" />
    <ProjectReference Include="../Orchestrator.Application/Orchestrator.Application.csproj" />
    <ProjectReference Include="../Orchestrator.Infrastructure/Orchestrator.Infrastructure.csproj" />
    <ProjectReference Include="../Orchestrator.AgentFramework/Orchestrator.AgentFramework.csproj" />
    <ProjectReference Include="../Orchestrator.Providers/Orchestrator.Providers.csproj" />
    <ProjectReference Include="../Orchestrator.Observability/Orchestrator.Observability.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.Local.json" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
